# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=iwiki

# Qdrant：local（本地文件，免部署，默认）/ server（连接 Qdrant 服务）
QDRANT_MODE=local
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=iwiki_chunks

# Embedding：hash（离线哈希向量，免 API Key，默认）/ dashscope（阿里云百炼 text-embedding-v3）
EMBEDDING_PROVIDER=hash
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# OCR
TESSERACT_CMD=
OCR_LANG=chi_sim+eng
OCR_ENGINE=auto
# PDF 后端：auto（pypdf 抽取 + fitz/pypdfium2 渲染）/ pypdf / fitz
PDF_BACKEND=auto

# 检索参数
RRF_K=60
RECALL_LIMIT=30
WEIGHT_KEYWORD=1.0
WEIGHT_SEMANTIC=1.0
